#!/bin/bash
# Pre-commit hook to catch issues before they're pushed
# Install: git config core.hooksPath .githooks

set -e

echo "🔍 Running pre-commit checks..."

# 1. Check that code compiles
echo "  → Checking if code compiles..."
if ! go build ./...; then
    echo "❌ Code does not compile. Fix errors before committing."
    exit 1
fi

# 2. Run go vet
echo "  → Running go vet..."
if ! go vet ./...; then
    echo "❌ go vet failed. Fix issues before committing."
    exit 1
fi

# 3. Run tests (quick sanity check)
echo "  → Running tests..."
if ! go test -timeout=30s ./...; then
    echo "❌ Tests failed. Fix before committing."
    exit 1
fi

# 4. Check for uncommitted files that should be committed
echo "  → Checking for untracked files..."
untracked=$(git ls-files --others --exclude-standard)
if [ -n "$untracked" ]; then
    echo "⚠️  Untracked files (not in this commit):"
    echo "$untracked" | sed 's/^/     /'
fi

echo "✅ Pre-commit checks passed!"
exit 0
