                "type": "string"
              },
              "remove_payload": {
                "description": "Remove the original payload after storing it (default: true)",
                "title": "Remove Payload",
                "type": "boolean"
              },
              "ticket_field_path": {
                "description": "Where to store the claim ticket (default: \"_claim_check\")",
                "title": "Ticket Field Path",
                "type": "string"
              }
            },
            "title": "Claim Check Options",
            "type": "object"
          }
        },
        "required": [
          "claim_check"
        ],
        "title": "Claim Check Step",
        "type": "object"
      },
      "description": "Externalize large message payloads to reduce memory usage"
    },
