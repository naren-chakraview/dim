      },
      "description": "Transform the message body using a JSONata expression"
    },
    {
      "name": "route-step",
      "type": "step",
      "config_schema": {
        "description": "Route messages to different branches based on content evaluation",
        "properties": {
          "route": {
            "properties": {
              "cases": {
                "additionalProperties": {
                  "properties": {
                    "target": {
                      "description": "Route or sink name for this case",
                      "title": "Target",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "description": "Map of case names to target route names",
                "title": "Route Cases",
                "type": "object"
              },
              "default": {
                "description": "Default route/sink if expression doesn't match any case",
                "title": "Default Target",
                "type": "string"
              },
              "expr": {
                "description": "JSONata expression that evaluates to a route/case name",
                "title": "Route Expression",
                "type": "string"
              }
            },
            "required": [
              "expr"
            ],
            "type": "object"
          }
        },
        "required": [
          "route"
        ],
        "title": "Content-Based Router Step",
        "type": "object"
      },
      "description": "Route messages to different branches based on content evaluation"
    },
    {
      "name": "wiretap-step",
      "type": "step",
      "config_schema": {
        "description": "Duplicate the message to a secondary sink without altering main flow",
        "properties": {
          "wiretap": {
            "properties": {
              "sink": {
                "description": "Sink name to duplicate the message to",
                "title": "Tap Sink",
                "type": "string"
              }
            },
            "required": [
              "sink"
            ],
            "type": "object"
          }
        },
        "required": [
          "wiretap"
        ],
        "title": "Wiretap Step",
        "type": "object"
      },
      "description": "Duplicate the message to a secondary sink without altering main flow"
    },
    {
      "name": "idempotent-step",
      "type": "step",
      "config_schema": {
        "description": "Suppress duplicate messages using a deduplication key",
        "properties": {
          "idempotent": {
            "properties": {
              "key_expr": {
                "description": "JSONata expression to extract the dedup key from the message",
                "title": "Deduplication Key Expression",
                "type": "string"
              }
            },
            "required": [
              "key_expr"
            ],
            "type": "object"
          }
        },
        "required": [
          "idempotent"
        ],
        "title": "Idempotent Deduplication Step",
        "type": "object"
      },
      "description": "Suppress duplicate messages using a deduplication key"
    },
    {
      "name": "authorize-step",
      "type": "step",
      "config_schema": {
        "description": "Enforce authorization policies (RBAC or ABAC)",
        "properties": {
          "authorize": {
            "properties": {
              "expr": {
                "description": "JSONata expression evaluated in ABAC mode",
                "title": "Expression",
                "type": "string"
              },
              "mode": {
                "description": "Authorization mode: 'rbac' (role-based), 'abac' (attribute-based) or 'pbac' (policy decision point)",
                "enum": [
                  "rbac",
                  "abac",
                  "pbac"
                ],
                "title": "Authorization Mode",
                "type": "string"
              },
              "on_deny": {
                "description": "Routing on authorization denial",
                "properties": {
                  "target": {
                    "description": "Sink name to route denied messages to",
                    "title": "Target Sink",
                    "type": "string"
                  }
                },
                "required": [
                  "target"
                ],
                "title": "On Deny",
                "type": "object"
              },
              "pdp": {
                "description": "Policy decision point settings for PBAC mode",
                "properties": {
                  "endpoint": {
                    "description": "PDP service endpoint (e.g., http://localhost:8181)",
                    "title": "Endpoint",
                    "type": "string"
                  },
                  "timeout": {
                    "description": "Timeout in milliseconds (default: 5000)",
                    "title": "Timeout (ms)",
                    "type": "integer"
                  }
                },
                "required": [
                  "endpoint"
                ],
                "title": "PDP",
                "type": "object"
              },
              "require_roles": {
                "description": "Roles required in RBAC mode",
                "items": {
                  "type": "string"
                },
                "title": "Required Roles",
                "type": "array"
              }
            },
            "required": [
              "mode"
            ],
            "type": "object"
          }
        },
        "required": [
          "authorize"
        ],
        "title": "Authorization Step",
        "type": "object"
      },
      "description": "Enforce authorization policies (RBAC or ABAC)"
    },
    {
      "name": "contract-step",
      "type": "step",
      "config_schema": {
        "description": "Enforce schema contracts on message payloads",
        "properties": {
          "contract": {
            "properties": {
              "id": {
                "description": "Contract identifier",
                "type": "string"
              },
              "strict": {
                "description": "Enforce strictly",
                "type": "boolean"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          }
        },
        "required": [
          "contract"
        ],
        "title": "Contract Step",
        "type": "object"
      },
      "description": "Enforce schema contracts on message payloads"
    },
    {
      "name": "claim_check-step",
      "type": "step",
      "config_schema": {
        "description": "Externalize large payloads to reduce memory usage",
        "properties": {
          "claim_check": {
            "properties": {
              "content_type": {
                "description": "MIME type hint for the stored payload",
                "title": "Content Type",
                "type": "string"
              },
              "payload_field": {
                "description": "Field to extract (default: \"body\")",
                "title": "Payload Field",
                "type": "string"
              },
              "remove_payload": {
                "description": "Remove the original payload after storing it (default: true)",
                "title": "Remove Payload",
                "type": "boolean"
              },
              "ticket_field_path": {
                "description": "Where to store the claim ticket (default: \"_claim_check\")",
                "title": "Ticket Field Path",
                "type": "string"
              }
            },
            "title": "Claim Check Options",
            "type": "object"
          }
        },
        "required": [
          "claim_check"
        ],
        "title": "Claim Check Step",
        "type": "object"
      },
      "description": "Externalize large payloads to reduce memory usage"
    },
    {
      "name": "claim_resolve-step",
      "type": "step",
      "config_schema": {
        "description": "Retrieve externalized payloads from claim check store",
        "properties": {
          "claim_resolve": {
            "properties": {
              "payload_field_path": {
                "description": "Where to restore the payload (default: \"body\")",
                "title": "Payload Field Path",
                "type": "string"
              },
              "ticket_field_path": {
                "description": "Where the claim ticket is (default: \"_claim_check\")",
                "title": "Ticket Field Path",
                "type": "string"
              }
            },
            "title": "Claim Resolve Options",
            "type": "object"
          }
        },
        "required": [
          "claim_resolve"
        ],
        "title": "Claim Resolve Step",
        "type": "object"
      },
      "description": "Retrieve externalized payloads from claim check store"
    },
    {
      "name": "claim-check",
      "type": "eip",
      "config_schema": {
        "description": "Externalize large payloads to reduce memory usage",
        "properties": {
          "claim_check": {
            "properties": {
